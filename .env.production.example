NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DEPLOY_ADAPTER=node

# URL publik (metadata, canonical links)
SITE_URL=https://datamatika.ipb.ac.id
# Jika TIDAK bisa mengubah nginx (hanya docker compose): wajib false
ASTRO_SECURITY_CHECK_ORIGIN=false
# Jika tim infra sudah set proxy_set_header X-Forwarded-* di nginx, bisa true:
# ASTRO_SECURITY_CHECK_ORIGIN=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_SESSION_SECRET=replace-with-long-random-secret

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_BUCKET=cms-assets
