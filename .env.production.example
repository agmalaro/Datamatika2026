NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DEPLOY_ADAPTER=node

# Public URL (wajib untuk CSRF/origin check di belakang nginx)
SITE_URL=https://datamatika.ipb.ac.id
# Hanya jika upload masih 403 setelah nginx proxy headers benar:
# ASTRO_SECURITY_CHECK_ORIGIN=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_SESSION_SECRET=replace-with-long-random-secret

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_BUCKET=cms-assets
