      function slugifyGalleryIdClient(input) {
        return String(input || "")
          .toLowerCase()
          .normalize("NFKD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "")
          .slice(0, 48);
      }

      async function uploadGalleryImageFile(file) {
        const formData = new FormData();
        formData.append("image", file);
        formData.append("uploadType", "gallery");
        const response = await fetch("/api/admin/upload", {
          method: "POST",
          body: formData,
        });
        if (!response.ok) {
          const data = await response.json().catch(() => ({ message: "Upload gagal." }));
          throw new Error(data.message ?? "Upload gagal.");
        }
        const data = await response.json();
        if (!data.url) throw new Error("URL upload tidak diterima.");
        return data.url;
      }

      async function bulkUploadGalleryToSection(sectionEl, fileList) {
        const photosList = sectionEl?.querySelector("[data-gallery-photos]");
        if (!photosList || !fileList?.length) return { ok: 0, fail: 0 };

        const files = [...fileList].filter((f) => f.type.startsWith("image/"));
        if (files.length === 0) {
          showToast("Tidak ada file gambar yang valid.", "err");
          return { ok: 0, fail: 0 };
        }

        let ok = 0;
        let fail = 0;
        showToast(`Mengunggah 0/${files.length} foto...`, "loading", 120000);

        for (let i = 0; i < files.length; i += 1) {
          showToast(`Mengunggah ${i + 1}/${files.length} foto...`, "loading", 120000);
          try {
            const url = await uploadGalleryImageFile(files[i]);
            createGalleryPhotoItem(photosList, { caption: "", image: url });
            ok += 1;
          } catch (err) {
            fail += 1;
            console.error(err);
          }
        }

        if (fail === 0) {
          setStatus(`${ok} foto berhasil diunggah. Klik Simpan Perubahan.`, "ok");
          showToast(`${ok} foto berhasil diunggah ke section ini.`, "ok");
        } else {
          setStatus(`${ok} berhasil, ${fail} gagal. Periksa ukuran/tipe file.`, "err");
          showToast(`${ok} berhasil, ${fail} gagal.`, "err");
        }
        return { ok, fail };
      }

