      function readAnnouncementPage() {
        const enabled =
          form?.elements?.namedItem("announcementEnabled") instanceof HTMLInputElement &&
          form.elements.namedItem("announcementEnabled").checked;
        const showHomeBanner =
          form?.elements?.namedItem("announcementShowHomeBanner") instanceof HTMLInputElement &&
          form.elements.namedItem("announcementShowHomeBanner").checked;
        const navLabel =
          form?.elements?.namedItem("announcementNavLabel") instanceof HTMLInputElement
            ? form.elements.namedItem("announcementNavLabel").value.trim()
            : "Pengumuman";
        const homeBannerText =
          form?.elements?.namedItem("announcementHomeBannerText") instanceof HTMLTextAreaElement
            ? form.elements.namedItem("announcementHomeBannerText").value.trim()
            : "";
        const homeBannerButtonLabel =
          form?.elements?.namedItem("announcementHomeBannerButtonLabel") instanceof HTMLInputElement
            ? form.elements.namedItem("announcementHomeBannerButtonLabel").value.trim()
            : "Lihat pengumuman";
        const title =
          form?.elements?.namedItem("announcementTitle") instanceof HTMLInputElement
            ? form.elements.namedItem("announcementTitle").value.trim()
            : "Pengumuman";
        const intro =
          form?.elements?.namedItem("announcementIntro") instanceof HTMLTextAreaElement
            ? form.elements.namedItem("announcementIntro").value.trim()
            : "";

        if (!announcementSectionsList) {
          return {
            enabled,
            showHomeBanner,
            homeBannerText,
            homeBannerButtonLabel,
            navLabel,
            title,
            intro,
            sections: [],
          };
        }

        const sections = [...announcementSectionsList.querySelectorAll(".announcement-section-item")]
          .map((item) => {
            const label = item.querySelector('[data-key="label"]')?.value?.trim() ?? "";
            const idRaw = item.querySelector('[data-key="id"]')?.value?.trim() ?? "";
            const body = item.querySelector('[data-key="body"]')?.value?.trim() ?? "";
            const bullets = (item.querySelector('[data-key="bullets"]')?.value ?? "")
              .split("\n")
              .map((line) => line.trim())
              .filter(Boolean);
            const links = (item.querySelector('[data-key="links"]')?.value ?? "")
              .split("\n")
              .map((line) => line.trim())
              .filter(Boolean)
              .map((line) => {
                const pipe = line.indexOf("|");
                if (pipe === -1) return null;
                const linkLabel = line.slice(0, pipe).trim();
                const href = line.slice(pipe + 1).trim();
                if (!linkLabel || !href) return null;
                return { label: linkLabel, href };
              })
              .filter(Boolean);
            const sheetEmbedUrl = item.querySelector('[data-key="sheetEmbedUrl"]')?.value?.trim() ?? "";
            const gallerySectionId = item.querySelector('[data-key="gallerySectionId"]')?.value?.trim() ?? "";
            const id = slugifyGalleryIdClient(idRaw || label) || "section";
            return {
              id,
              label,
              body,
              bullets,
              links,
              ...(sheetEmbedUrl ? { sheetEmbedUrl } : {}),
              ...(gallerySectionId ? { gallerySectionId } : {}),
            };
          })
          .filter((sec) => sec.label.length > 0);

        const used = new Set();
        const deduped = sections.map((sec) => {
          let id = sec.id;
          let n = 2;
          while (used.has(id)) {
            id = `${sec.id}-${n}`;
            n += 1;
          }
          used.add(id);
          return { ...sec, id };
        });

        return {
          enabled,
          showHomeBanner,
          homeBannerText,
          homeBannerButtonLabel,
          navLabel,
          title,
          intro,
          sections: deduped,
        };
      }

      function announcementSectionHasContent(sec) {
        return Boolean(
          sec.body?.trim() ||
            (sec.bullets && sec.bullets.length > 0) ||
            sec.sheetEmbedUrl?.trim() ||
            (sec.links && sec.links.length > 0) ||
            sec.gallerySectionId?.trim()
        );
      }

      function validateAnnouncementBeforeSave(page) {
        if (!page.enabled) return true;
        const hasContent = page.sections.some(announcementSectionHasContent);
        if (!hasContent) {
          showToast("Pengumuman aktif: isi minimal satu tab (teks, sheet, link, atau id galeri).", "err");
          document.getElementById("section-announcement")?.scrollIntoView({ behavior: "smooth", block: "start" });
          return false;
        }
        return true;
      }

      function initAnnouncementAdmin() {
        const root = document.getElementById("section-announcement");
        if (!root || root.dataset.announcementAdminInit === "1") return;
        root.dataset.announcementAdminInit = "1";

        root.addEventListener("click", (event) => {
          const el = event.target;
          if (!(el instanceof Element)) return;
          const actionEl = el.closest("[data-action]");
          if (!actionEl || !root.contains(actionEl)) return;
          const action = actionEl.getAttribute("data-action");
          if (action !== "add-announcement-section" && action !== "remove-announcement-section") return;

          if (actionEl instanceof HTMLButtonElement) {
            event.preventDefault();
            event.stopPropagation();
          }

          if (action === "add-announcement-section") {
            createAnnouncementSectionItem();
            showToast("Tab pengumuman ditambahkan.", "ok");
            return;
          }

          if (action === "remove-announcement-section") {
            actionEl.closest(".announcement-section-item")?.remove();
            renumberAnnouncementSections();
            showToast("Tab pengumuman dihapus.", "ok");
          }
        });
      }

