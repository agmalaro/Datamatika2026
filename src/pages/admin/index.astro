          <input data-key="image" type="hidden" value="${(entry.image ?? "").replace(/"/g, "&quot;")}" />
          <img class="speaker-preview" width="200" height="150" style="object-fit:contain;display:block;" src="${normalizePreviewUrl(entry.image || "/patterns/empty.svg")}" alt="Preview galeri" onerror="this.onerror=null;this.src='/patterns/empty.svg';" />
          <div class="speaker-actions">
            <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" />
