      function readGuideEditorialSections() {
        if (!guideEditorialList) return [];
        return [...guideEditorialList.querySelectorAll(".editorial-item")]
          .map((item) => {
            const heading = item.querySelector('[data-key="heading"]')?.value?.trim() ?? "";
