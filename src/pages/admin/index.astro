      function getGalleryPageSeeds() {
        const fallback = [{ id: "seminar", label: "Galeri Seminar", items: [] }];
        try {
          const parsed = JSON.parse(initialGalleryPageJson);
          if (parsed && Array.isArray(parsed.sections) && parsed.sections.length > 0) {
            return parsed.sections;
          }
        } catch (err) {
          console.error("[gallery-admin] Gagal parse data galeri:", err);
        }
        return fallback;
      }

      function initGalleryPageAdmin() {
        const root = document.getElementById("section-gallery");
        const list = document.getElementById("gallery-sections-list");
        if (!root || !list) {
          console.warn("[gallery-admin] Elemen galeri tidak ditemukan di DOM.");
          return;
        }

        if (!list.querySelector(".gallery-section-item")) {
          for (const sec of getGalleryPageSeeds()) {
            try {
              createGallerySection(sec ?? { id: "", label: "", items: [] });
            } catch (err) {
              console.error("[gallery-admin] Gagal membuat section:", err);
            }
          }
        }

        if (root.dataset.galleryAdminInit === "1") return;
        root.dataset.galleryAdminInit = "1";

        root.addEventListener("click", async (event) => {
          const el = event.target;
          if (!(el instanceof Element)) return;
          const actionEl = el.closest("[data-action]");
          if (!actionEl || !root.contains(actionEl)) return;
          const action = actionEl.getAttribute("data-action");
          const galleryActions = new Set([
            "add-gallery-section",
            "add-gallery-photo",
            "pick-bulk-gallery",
            "remove-gallery-section",
            "remove-gallery-photo",
            "upload-gallery-photo",
          ]);
          if (!action || !galleryActions.has(action)) return;

          if (actionEl instanceof HTMLButtonElement) {
            event.preventDefault();
            event.stopPropagation();
          }

          if (action === "add-gallery-section") {
            addGallerySectionFromUi();
            return;
          }

          if (action === "add-gallery-photo") {
            const sectionEl = actionEl.closest(".gallery-section-item");
            const photosList = sectionEl?.querySelector("[data-gallery-photos]");
            createGalleryPhotoItem(photosList, { caption: "", image: "" });
            showToast("Slot foto ditambahkan.", "ok");
            return;
          }

          if (action === "pick-bulk-gallery") {
            const sectionEl = actionEl.closest(".gallery-section-item");
            const bulkInput = sectionEl?.querySelector(".gallery-bulk-input");
            if (bulkInput instanceof HTMLInputElement) bulkInput.click();
            return;
          }

          if (action === "remove-gallery-section") {
            actionEl.closest(".gallery-section-item")?.remove();
            renumberGallerySections();
            showToast("Section galeri dihapus.", "ok");
            return;
          }

          if (action === "remove-gallery-photo") {
            actionEl.closest(".gallery-photo-item")?.remove();
            return;
          }

          if (action === "upload-gallery-photo") {
            const photoItem = actionEl.closest(".gallery-photo-item");
            if (!photoItem) return;
            const fileInput = photoItem.querySelector('input[type="file"]:not(.gallery-bulk-input)');
            if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.length) {
              fileInput?.click();
              showToast("Pilih file gambar dulu.", "err");
              return;
            }
            if (!(actionEl instanceof HTMLButtonElement)) return;
            actionEl.disabled = true;
            const prevLabel = actionEl.textContent;
            actionEl.textContent = "Uploading...";
            try {
              const url = await uploadGalleryImageFile(fileInput.files[0]);
              const imageInput = photoItem.querySelector('[data-key="image"]');
              const preview = photoItem.querySelector(".speaker-preview");
              if (imageInput instanceof HTMLInputElement) imageInput.value = url;
              setPreviewSource(preview, url);
              fileInput.value = "";
              setStatus("Foto galeri berhasil diupload. Jangan lupa klik Simpan Perubahan.", "ok");
              showToast("Foto berhasil diunggah.", "ok");
            } catch (err) {
              const message = err instanceof Error ? err.message : "Upload gagal.";
              setStatus(message, "err");
              showToast(message, "err");
            } finally {
              actionEl.disabled = false;
              actionEl.textContent = prevLabel || "Upload Foto";
            }
          }
        });

        root.addEventListener("change", async (event) => {
          const target = event.target;
          if (!(target instanceof HTMLInputElement) || target.type !== "file") return;
          if (!root.contains(target) || !target.files?.length) return;

          if (target.classList.contains("gallery-bulk-input")) {
            const sectionEl = target.closest(".gallery-section-item");
            if (!sectionEl) return;
            const bulkBtn = sectionEl.querySelector('[data-action="pick-bulk-gallery"]');
            if (bulkBtn instanceof HTMLButtonElement) bulkBtn.disabled = true;
            await bulkUploadGalleryToSection(sectionEl, target.files);
            target.value = "";
            if (bulkBtn instanceof HTMLButtonElement) bulkBtn.disabled = false;
            return;
          }

          const photoItem = target.closest(".gallery-photo-item");
          if (!photoItem) return;
          const preview = photoItem.querySelector(".speaker-preview");
          setPreviewSource(preview, URL.createObjectURL(target.files[0]));
        });
      }

      function readGalleryPage() {
        const title =
          form?.elements?.namedItem?.("galleryPageTitle") instanceof HTMLInputElement
            ? form.elements.namedItem("galleryPageTitle").value.trim()
            : "Galeri";
        if (!gallerySectionsList) return { title, sections: [] };

        const sections = [...gallerySectionsList.querySelectorAll(".gallery-section-item")]
          .map((sectionEl) => {
            const label = sectionEl.querySelector('[data-key="label"]')?.value?.trim() ?? "";
            const idRaw = sectionEl.querySelector('[data-key="id"]')?.value?.trim() ?? "";
            const id = slugifyGalleryIdClient(idRaw || label) || "section";
            const items = [...sectionEl.querySelectorAll(".gallery-photo-item")]
              .map((photoEl) => {
                const caption = photoEl.querySelector('[data-key="caption"]')?.value?.trim() ?? "";
                const image = photoEl.querySelector('[data-key="image"]')?.value?.trim() ?? "";
                return {
                  ...(caption ? { caption } : {}),
                  ...(image ? { image } : {}),
                };
              })
              .filter((entry) => entry.image);
            return { id, label, items };
          })
          .filter((sec) => sec.label.length > 0);

        const used = new Set();
        const deduped = sections.map((sec) => {
          let id = sec.id;
          let n = 2;
          while (used.has(id)) {
            id = `${sec.id}-${n}`;
            n += 1;
          }
          used.add(id);
          return { ...sec, id };
        });

        return { title, sections: deduped };
      }

      function getAnnouncementPageSeeds() {
        const fallback = { sections: [] };
        try {
          const parsed = JSON.parse(initialAnnouncementPageJson);
          if (parsed && Array.isArray(parsed.sections)) return parsed;
        } catch (err) {
          console.error("[announcement-admin] Gagal parse data:", err);
        }
        return fallback;
      }

      function renumberAnnouncementSections() {
        if (!announcementSectionsList) return;
        announcementSectionsList.querySelectorAll(".announcement-section-item").forEach((node, index) => {
          const title = node.querySelector(".announcement-section-item__title");
          if (title) title.textContent = `Tab pengumuman #${index + 1}`;
        });
      }

