          '<div class="editorial-item__field">',
          "  <label>Paragraf</label>",
          '  <textarea data-key="body" rows="5"></textarea>',
          "  <p class=\"editorial-item__hint\">Pisahkan paragraf dengan baris kosong. URL https://... otomatis jadi link.</p>",
          "</div>",
