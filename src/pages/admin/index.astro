            const imageAlt = item.querySelector('[data-key="imageAlt"]')?.value?.trim() ?? "";
            const sheetEmbedUrl = item.querySelector('[data-key="sheetEmbedUrl"]')?.value?.trim() ?? "";
            const formEmbedUrl = item.querySelector('[data-key="formEmbedUrl"]')?.value?.trim() ?? "";
