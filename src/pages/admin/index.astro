      function initPartnersAdmin() {
        const root = document.getElementById("section-partners");
        if (!root || root.dataset.partnersAdminInit === "1") return;
        root.dataset.partnersAdminInit = "1";

        root.addEventListener("click", async (event) => {
          const el = event.target;
          if (!(el instanceof Element)) return;
          const actionEl = el.closest("[data-action]");
          if (!actionEl || !root.contains(actionEl)) return;
          const action = actionEl.getAttribute("data-action");
          if (
            action !== "add-partner" &&
            action !== "remove-partner" &&
            action !== "upload-partner-logo"
          ) {
            return;
          }

          if (actionEl instanceof HTMLButtonElement) {
            event.preventDefault();
            event.stopPropagation();
          }

          if (action === "add-partner") {
            const item = createPartnerItem();
            item?.scrollIntoView({ behavior: "smooth", block: "nearest" });
            showToast("Baris partner ditambahkan.", "ok");
            return;
          }

          const item = actionEl.closest(".partner-item");
          if (!item) return;

          if (action === "remove-partner") {
            item.remove();
            updatePartnersEmptyHint();
            showToast("Partner dihapus.", "ok");
            return;
          }

          if (action === "upload-partner-logo") {
            const fileInput = item.querySelector('input[type="file"]');
            if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.length) {
              fileInput?.click();
              showToast("Pilih file logo dulu.", "err");
              return;
            }
            if (!(actionEl instanceof HTMLButtonElement)) return;
            actionEl.disabled = true;
            const prevLabel = actionEl.textContent;
            actionEl.textContent = "Uploading...";
            try {
              const formData = new FormData();
              formData.append("image", fileInput.files[0]);
              formData.append("uploadType", "partner");
              const response = await fetch("/api/admin/upload", { method: "POST", body: formData });
              if (!response.ok) {
                const data = await response.json().catch(() => ({ message: "Upload gagal." }));
                throw new Error(data.message ?? "Upload gagal.");
              }
              const data = await response.json();
              const imageInput = item.querySelector('[data-key="image"]');
              const preview = item.querySelector(".speaker-preview");
              if (imageInput instanceof HTMLInputElement) imageInput.value = data.url;
              setPreviewSource(preview, data.url);
              fileInput.value = "";
              setStatus("Logo partner berhasil diupload. Jangan lupa klik Simpan Perubahan.", "ok");
              showToast("Logo partner diunggah.", "ok");
            } catch (err) {
              const message = err instanceof Error ? err.message : "Upload gagal.";
              setStatus(message, "err");
              showToast(message, "err");
            } finally {
              actionEl.disabled = false;
              actionEl.textContent = prevLabel || "Upload Logo";
            }
          }
        });

        root.addEventListener("change", (event) => {
          const target = event.target;
          if (!(target instanceof HTMLInputElement) || target.type !== "file") return;
          if (!root.contains(target) || !target.files?.length) return;
          const item = target.closest(".partner-item");
          if (!item) return;
          const preview = item.querySelector(".speaker-preview");
          setPreviewSource(preview, URL.createObjectURL(target.files[0]));
        });
      }

