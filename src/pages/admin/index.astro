          initGalleryPageAdmin();
          initPartnersAdmin();
          initSpeakersAdmin();
          initAnnouncementAdmin();
        });
      } else {
        initGalleryPageAdmin();
        initPartnersAdmin();
        initSpeakersAdmin();
        initAnnouncementAdmin();
      }
