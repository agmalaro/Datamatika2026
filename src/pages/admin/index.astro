      function createFooterProgramRow(item = { label: "", href: "" }) {
        if (!footerProgramList) return;
        const row = document.createElement("div");
        row.className = "footer-program-row";
        row.innerHTML = [
          '<input data-key="label" type="text" placeholder="Label chip (mis. Statistika)" required />',
          '<input data-key="href" type="url" placeholder="https://..." required />',
          '<button class="footer-program-row__remove" type="button" data-action="remove-footer-program">Hapus</button>',
        ].join("");
        const labelInput = row.querySelector('[data-key="label"]');
        const hrefInput = row.querySelector('[data-key="href"]');
        if (labelInput instanceof HTMLInputElement) labelInput.value = item.label ?? "";
        if (hrefInput instanceof HTMLInputElement) hrefInput.value = item.href ?? "";
        footerProgramList.appendChild(row);
      }

      function readFooterPrograms() {
        if (!footerProgramList) return [];
        return [...footerProgramList.querySelectorAll(".footer-program-row")]
          .map((row) => ({
            label: row.querySelector('[data-key="label"]')?.value?.trim() ?? "",
            href: row.querySelector('[data-key="href"]')?.value?.trim() ?? "",
          }))
          .filter((entry) => entry.label && entry.href);
      }

      function setFooterBannerPreview(url) {
        if (!(footerBannerPreview instanceof HTMLImageElement)) return;
        setPreviewSource(footerBannerPreview, url);
      }

      initGalleryPageAdmin();
      initPartnersAdmin();
      initSpeakersAdmin();
      initAnnouncementAdmin();

      for (const speaker of speakerSeeds) createSpeakerItem(speaker);
      for (const partner of partnerSeeds) createPartnerItem(partner);
      updatePartnersEmptyHint();
      for (const sec of getAnnouncementPageSeeds().sections ?? []) {
        createAnnouncementSectionItem(sec);
      }
      for (const sec of editorialSeeds) createGuideEditorialItem(sec);
      for (const program of footerProgramSeeds) createFooterProgramRow(program);

      guideEditorialList?.addEventListener("click", async (event) => {
        const el = event.target;
        if (!(el instanceof Element)) return;
        const actionEl = el.closest("[data-action]");
        if (!actionEl || !guideEditorialList.contains(actionEl)) return;
        const action = actionEl.getAttribute("data-action");

        if (action === "remove-editorial") {
          const item = actionEl.closest(".editorial-item");
          if (!item || item.classList.contains("announcement-section-item")) return;
          item.remove();
          renumberEditorialItems();
          return;
        }

        if (action === "upload-editorial-image") {
          const item = actionEl.closest(".editorial-item");
          if (!item || item.classList.contains("announcement-section-item")) return;
          const fileInput = item.querySelector('input[type="file"]');
          if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.length) {
            fileInput?.click();
            setStatus("Pilih file gambar dulu, lalu klik Upload Gambar lagi.", "err");
            showToast("Pilih file gambar dulu sebelum upload.", "err");
            return;
          }
          if (!(actionEl instanceof HTMLButtonElement)) return;

          const formData = new FormData();
          formData.append("image", fileInput.files[0]);
          formData.append("uploadType", "guideEditorialImage");

          actionEl.disabled = true;
          const prevLabel = actionEl.textContent;
          actionEl.textContent = "Uploading...";
          const response = await fetch("/api/admin/upload", {
            method: "POST",
            body: formData,
          });
          actionEl.disabled = false;
          actionEl.textContent = prevLabel || "Upload Gambar";

          if (!response.ok) {
            const data = await response.json().catch(() => ({ message: "Upload gagal." }));
            setStatus(data.message ?? "Upload gagal.", "err");
            showToast(data.message ?? "Upload gagal.", "err");
            return;
          }

          const data = await response.json();
          const imageInput = item.querySelector('[data-key="image"]');
          const preview = item.querySelector(".editorial-image-preview");
          if (imageInput instanceof HTMLInputElement) imageInput.value = data.url;
          setPreviewSource(preview, data.url);
          if (fileInput instanceof HTMLInputElement) fileInput.value = "";
          setStatus("Gambar redaksi berhasil diupload. Jangan lupa klik Simpan Perubahan.", "ok");
          showToast("Gambar redaksi berhasil diunggah.", "ok");
        }
      });

      guideEditorialList?.addEventListener("change", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement) || target.type !== "file") return;
        if (!target.files?.length) return;
        const item = target.closest(".editorial-item");
        if (!item || item.classList.contains("announcement-section-item")) return;
        const preview = item.querySelector(".editorial-image-preview");
        setPreviewSource(preview, URL.createObjectURL(target.files[0]));
      });

      guideEditorialList?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        if (!target.classList.contains("editorial-image-preview")) return;
        const item = target.closest(".editorial-item");
        if (!item || item.classList.contains("announcement-section-item")) return;
        const fileInput = item?.querySelector('input[type="file"]');
        if (fileInput instanceof HTMLInputElement) fileInput.click();
      });

      footerProgramList?.addEventListener("click", (event) => {
        const el = event.target;
        if (!(el instanceof Element)) return;
        const actionEl = el.closest('[data-action="remove-footer-program"]');
        if (!actionEl || !footerProgramList.contains(actionEl)) return;
        actionEl.closest(".footer-program-row")?.remove();
      });

      addGuideEditorialBtn?.addEventListener("click", () =>
        createGuideEditorialItem({
          heading: "",
          body: "",
          bullets: [],
          image: "",
          imageAlt: "",
          sheetEmbedUrl: "",
          formEmbedUrl: "",
        })
      );
      addFooterProgramBtn?.addEventListener("click", () => createFooterProgramRow({ label: "", href: "" }));

      footerBannerFileInput?.addEventListener("change", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement) || !target.files?.length) return;
        setFooterBannerPreview(URL.createObjectURL(target.files[0]));
        if (uploadFooterBannerBtn) uploadFooterBannerBtn.textContent = "Klik lagi untuk mengunggah";
      });

      uploadFooterBannerBtn?.addEventListener("click", async () => {
        if (!(footerBannerFileInput instanceof HTMLInputElement) || !footerBannerFileInput.files?.length) {
          footerBannerFileInput?.click();
          return;
        }

        const formData = new FormData();
        formData.append("image", footerBannerFileInput.files[0]);
        formData.append("uploadType", "footerBanner");

        uploadFooterBannerBtn.setAttribute("disabled", "true");
        uploadFooterBannerBtn.textContent = "Uploading...";
