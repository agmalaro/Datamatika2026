---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EditorialRichText from "../components/EditorialRichText.astro";
import GuideGoogleEmbed from "../components/GuideGoogleEmbed.astro";
import { getSiteData, images } from "../data/site";
import { resolveGoogleEmbedUrl } from "../lib/google-embed";

const { siteMeta, uploadNote, guide } = await getSiteData();
const submitUrl = uploadNote.primaryUrl?.trim() || siteMeta.registrationUrl;
const flowSteps = guide.flowSteps.length > 0 ? guide.flowSteps : ["Alur submit belum diatur dari CMS."];
const flowImage = guide.flowImage?.trim() || images.logo;
const templateUrl = guide.templateUrl?.trim() || "/files/Template-Seminar-Nasional-2026.docx";
const templateLabel = guide.templateLabel?.trim() || "Unduh Template Artikel (.docx)";
const pageTitle = guide.pageTitle?.trim() || "Panduan Submit Artikel Seminar";
const pageIntro = guide.pageIntro?.trim() || "";
const editorialSections = guide.editorialSections?.length ? guide.editorialSections : [];

function paragraphsFromBody(body: string): string[] {
  return body
    .split(/\n\n+/)
    .map((p) => p.trim())
    .filter(Boolean);
}
---

<BaseLayout title="Panduan Submit Artikel | DATAMATIKA 2026">
  <SiteHeader />
  <main id="main">
    <section class="section section--gallery-page">
      <div class="wrap panduan-page">
        <h1 class="heading-accent heading-accent--lg">{pageTitle}</h1>
        {pageIntro ? <p class="panduan-intro">{pageIntro}</p> : null}

        <article class="panduan-card panduan-grid">
          <div>
            <h2>{guide.flowTitle}</h2>
            <ol>
              {flowSteps.map((step) => <li>{step}</li>)}
            </ol>
            <div class="form-actions" style="margin-top: 1.5rem;">
              <a class="btn btn--primary" href={submitUrl} target="_blank" rel="noopener noreferrer">Buka Halaman Submit</a>
            </div>
          </div>
          <figure class="panduan-figure">
            <img src={flowImage} alt="Ilustrasi alur submit DATAMATIKA" loading="lazy" decoding="async" />
            <figcaption>Ilustrasi alur submit artikel seminar.</figcaption>
          </figure>
        </article>

        <article class="panduan-card">
          <h2>Unduh Template Artikel</h2>
          <p>Gunakan template resmi berikut sebelum melakukan submit naskah.</p>
          <div class="form-actions" style="margin-top: 1.25rem;">
            <a class="btn btn--ghost" href={templateUrl} download>
              <svg style="margin-right: 0.4rem;" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              {templateLabel}
            </a>
          </div>
        </article>

        <article class="panduan-card panduan-card--free">
          <h2>Biaya Pendaftaran Seminar</h2>
          {
            guide.fee.type === "paid" ? (
              <>
                <p>
                  <strong>Biaya:</strong> {guide.fee.paidAmount}
                </p>
                <p>
                  <strong>Rekening Tujuan:</strong> {guide.fee.paidAccountNumber} a.n. {guide.fee.paidAccountName}
                </p>
              </>
            ) : (
              <p>
                <strong>{guide.fee.freeText}</strong>
              </p>
            )
          }
        </article>

        {
          editorialSections.length > 0 ? (
            <div class="panduan-editorial-stack">
              <h2 class="panduan-editorial-stack__title">Informasi &amp; ketentuan</h2>
              {editorialSections.map((sec) => {
                const imageUrl = sec.image?.trim() ?? "";
                const sheetSrc = resolveGoogleEmbedUrl(sec.sheetEmbedUrl ?? "", "sheet");
                const formSrc = resolveGoogleEmbedUrl(sec.formEmbedUrl ?? "", "form");
                return (
                  <article class="panduan-card">
                    <h2>{sec.heading}</h2>
                    <div class:list={["panduan-editorial-body", imageUrl && "panduan-editorial-body--with-image"]}>
                      <div class="panduan-editorial-text">
                        {paragraphsFromBody(sec.body).map((para) => (
                          <p class="panduan-rich-text">
                            <EditorialRichText text={para} />
                          </p>
                        ))}
                        {sec.bullets && sec.bullets.length > 0 ? (
                          <ul class="panduan-rich-list">
                            {sec.bullets.map((item) => (
                              <li class="panduan-rich-text">
                                <EditorialRichText text={item} />
                              </li>
                            ))}
                          </ul>
                        ) : null}
                      </div>
                      {imageUrl ? (
                        <figure class="panduan-editorial-media">
                          <img
                            src={imageUrl}
                            alt={sec.imageAlt?.trim() || sec.heading}
                            loading="lazy"
                            decoding="async"
                          />
                        </figure>
                      ) : null}
                    </div>
                    {sheetSrc || formSrc ? (
                      <div class="panduan-editorial-embeds">
                        {sheetSrc ? (
                          <GuideGoogleEmbed src={sheetSrc} title={`Google Sheet: ${sec.heading}`} kind="sheet" />
                        ) : null}
                        {formSrc ? (
                          <GuideGoogleEmbed src={formSrc} title={`Google Form: ${sec.heading}`} kind="form" />
                        ) : null}
                      </div>
                    ) : null}
                  </article>
                );
              })}
            </div>
          ) : null
        }
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .panduan-page {
    display: grid;
    gap: 1rem;
  }

  .panduan-intro {
    margin: 0;
    color: var(--muted);
  }

  .panduan-editorial-stack {
    display: grid;
    gap: 1rem;
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .panduan-editorial-stack__title {
    margin: 0;
    font-size: 1.15rem;
    color: var(--muted);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .panduan-card {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.84);
    border-radius: var(--radius-md);
    padding: 1rem;
    box-shadow: var(--shadow-sm);
  }

  .panduan-card h2 {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .panduan-editorial-body {
    display: block;
  }

  .panduan-editorial-body--with-image {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr minmax(200px, 360px);
    align-items: start;
  }

  @media (max-width: 768px) {
    .panduan-editorial-body--with-image {
      grid-template-columns: 1fr;
    }
  }

  .panduan-editorial-text p:last-child {
    margin-bottom: 0;
  }

  .panduan-editorial-media {
    margin: 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    overflow: hidden;
  }

  .panduan-editorial-media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-sm);
  }

  .panduan-rich-text :global(a) {
    color: rgb(var(--brand-rgb));
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .panduan-rich-text :global(a:hover) {
    opacity: 0.85;
  }

  .panduan-rich-list {
    margin: 0.5rem 0 0 1.1rem;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .panduan-card ul:not(.panduan-rich-list),
  .panduan-card ol {
    margin: 0.5rem 0 0 1.1rem;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .panduan-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    align-items: center;
  }

  .panduan-figure {
    margin: 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    text-align: center;
    overflow: hidden;
  }

  .panduan-figure img {
    width: min(100%, 360px);
    height: auto;
    display: block;
    margin: 0 auto;
    border-radius: var(--radius-sm);
  }

  .panduan-figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .panduan-card--free {
    border-color: rgba(var(--brand-rgb), 0.35);
    background: rgba(var(--brand-rgb), 0.08);
  }
</style>
