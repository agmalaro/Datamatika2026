---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getSiteData } from "../data/site";

const { galleryPage } = await getSiteData();
const pageTitle = galleryPage.title?.trim() || "Galeri";
const sections = galleryPage.sections ?? [];
const defaultSectionId = sections[0]?.id ?? "";
---

<BaseLayout title={`${pageTitle} | DATAMATIKA 2026`}>
  <SiteHeader />
  <main id="main">
    <section class="section section--gallery-page">
      <div class="wrap gallery-page">
        <h1 class="heading-accent heading-accent--lg">{pageTitle}</h1>

        {
          sections.length > 0 ? (
            <>
              <div
                class="gallery-tabs"
                role="tablist"
                aria-label="Kategori galeri"
                data-default-section={defaultSectionId}
              >
                {sections.map((section, index) => (
                  <button
                    type="button"
                    class:list={["gallery-tab", index === 0 && "gallery-tab--active"]}
                    role="tab"
                    id={`gallery-tab-${section.id}`}
                    aria-selected={index === 0 ? "true" : "false"}
                    aria-controls={`gallery-panel-${section.id}`}
                    data-section-id={section.id}
                  >
                    {section.label}
                  </button>
                ))}
              </div>

              {sections.map((section, index) => (
                <div
                  id={`gallery-panel-${section.id}`}
                  class="gallery-panel"
                  role="tabpanel"
                  aria-labelledby={`gallery-tab-${section.id}`}
                  data-section-id={section.id}
                  hidden={index !== 0 ? true : undefined}
                >
                  {section.items.length > 0 ? (
                    <div class="gallery-grid">
                      {section.items.map((item) => (
                        <figure class="gallery-card reveal">
                          <button
                            type="button"
                            class="gallery-card__trigger"
                            data-gallery-src={item.src}
                            data-gallery-caption={item.caption ?? ""}
                            aria-label={
                              item.caption
                                ? `Perbesar foto: ${item.caption}`
                                : `Perbesar foto dari ${section.label}`
                            }
                          >
                            <img
                              src={item.src}
                              alt={item.caption || section.label}
                              loading="lazy"
                              decoding="async"
                            />
                            {item.caption && (
                              <span class="gallery-card__caption">{item.caption}</span>
                            )}
                          </button>
                        </figure>
                      ))}
                    </div>
                  ) : (
                    <p class="gallery-empty">Belum ada foto di kategori ini.</p>
                  )}
                </div>
              ))}
            </>
          ) : (
            <p class="gallery-empty">Belum ada kategori galeri yang ditampilkan.</p>
          )
        }
      </div>
    </section>
    <dialog class="gallery-lightbox" id="gallery-lightbox" aria-labelledby="gallery-lightbox-caption">
      <button type="button" class="gallery-lightbox__close" aria-label="Tutup" data-gallery-lightbox-close>
        <span aria-hidden="true">&times;</span>
      </button>
      <figure class="gallery-lightbox__figure">
        <img id="gallery-lightbox-img" alt="" decoding="async" />
        <figcaption id="gallery-lightbox-caption"></figcaption>
      </figure>
    </dialog>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  function activateGallerySection(sectionId: string) {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".gallery-tab[data-section-id]");
    const panels = document.querySelectorAll<HTMLElement>(".gallery-panel[data-section-id]");
    let found = false;

    tabs.forEach((tab) => {
      const isActive = tab.dataset.sectionId === sectionId;
      if (isActive) found = true;
      tab.classList.toggle("gallery-tab--active", isActive);
      tab.setAttribute("aria-selected", isActive ? "true" : "false");
    });

    panels.forEach((panel) => {
      const isActive = panel.dataset.sectionId === sectionId;
      if (isActive) {
        panel.removeAttribute("hidden");
      } else {
        panel.setAttribute("hidden", "");
      }
    });

    return found;
  }

  function sectionIdFromHash(): string {
    return decodeURIComponent(window.location.hash.replace(/^#/, "").trim());
  }

  function initGalleryTabs() {
    const tablist = document.querySelector<HTMLElement>(".gallery-tabs");
    if (!tablist) return;

    const defaultId = tablist.dataset.defaultSection ?? "";
    const hashId = sectionIdFromHash();
    const initialId = hashId && activateGallerySection(hashId) ? hashId : defaultId;
    if (initialId) activateGallerySection(initialId);

    tablist.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const tab = target.closest<HTMLButtonElement>(".gallery-tab[data-section-id]");
      if (!tab?.dataset.sectionId) return;
      const id = tab.dataset.sectionId;
      activateGallerySection(id);
      history.replaceState(null, "", `#${encodeURIComponent(id)}`);
    });

    window.addEventListener("hashchange", () => {
      const id = sectionIdFromHash();
      if (id) activateGallerySection(id);
    });
  }

  function initGalleryLightbox() {
    const dialog = document.getElementById("gallery-lightbox");
    const img = document.getElementById("gallery-lightbox-img");
    const captionEl = document.getElementById("gallery-lightbox-caption");
    if (!(dialog instanceof HTMLDialogElement) || !(img instanceof HTMLImageElement) || !captionEl) {
      return;
    }

    if (dialog.dataset.lightboxInit === "1") return;
    dialog.dataset.lightboxInit = "1";

    const close = () => {
      if (dialog.open) dialog.close();
    };

    const open = (src: string, caption: string, alt: string) => {
      img.src = src;
      img.alt = alt;
      if (caption.trim()) {
        captionEl.textContent = caption;
        captionEl.hidden = false;
      } else {
        captionEl.textContent = "";
        captionEl.hidden = true;
      }
      dialog.showModal();
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLButtonElement>(".gallery-card__trigger[data-gallery-src]");
      if (!trigger) return;
      const src = trigger.dataset.gallerySrc?.trim();
      if (!src) return;
      const caption = trigger.dataset.galleryCaption?.trim() ?? "";
      const thumb = trigger.querySelector("img");
      const alt = thumb instanceof HTMLImageElement ? thumb.alt : caption || "Foto galeri";
      open(src, caption, alt);
    });

    dialog.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (
        target.closest("[data-gallery-lightbox-close]") ||
        target === dialog
      ) {
        close();
      }
    });

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      close();
    });
  }

  function initGalleryPage() {
    initGalleryTabs();
    initGalleryLightbox();
  }

  initGalleryPage();
  document.addEventListener("astro:page-load", initGalleryPage);
</script>
