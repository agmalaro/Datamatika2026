# Salin ke .env untuk npm run dev (localhost).
# Supabase: isi SAMA dengan .env.production di server/Docker agar data & upload satu sumber.
# Alternatif: cukup isi .env.production saja — dev otomatis membacanya jika .env belum ada.

DEPLOY_ADAPTER=node
SITE_URL=http://localhost:4321

ADMIN_USERNAME=datamatika2026
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-very-long-random-secret

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=cms-assets
